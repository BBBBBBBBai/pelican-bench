node_modules/
dist/
data/
*.log
.env

# API Key 单独存放，绝不入库；连带把各种 .backup 副本一起挡掉
config.local.json
config.local*.json

# 打包中间产物与成品 exe：体积几十 MB，不进仓库。构建脚本本身要入库。
/build/*
!/build/build-exe.mjs

# 编辑器 / 工具留下的本机副本与恢复产物
.backup/
.acl-recovery/
tmp-*.txt
.tmp-*/

# 只在本机使用的开发期素材：探针脚本、设计巡检报告与截图
/tools/
/.impeccable/

# 图标设计过程的草稿（候选图、对比页、渲染脚本）。最终源图在 assets/pelican-logo.svg。
/icon-design/

# 内部设计 / 产品文档，不对外
/DESIGN.md
/PRODUCT.md
